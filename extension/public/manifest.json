{
  "name": "Rails Panel",
  "version": "2.5.2",
  "manifest_version": 3,
  "description": "Devtools panel for Rails development",
  "devtools_page": "devtools.html",
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "activeTab",
    "offscreen",
    "clipboardWrite",
    "clipboardRead"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "icons": {
     "16": "Rails_Logo_16x16.png",
     "32": "Rails_Logo_32x32.png",
     "48": "Rails_Logo_48x48.png",
    "128": "Rails_Logo_128x128.png"
  }
}
